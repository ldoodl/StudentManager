<?xml version="1.0" encoding="UTF-8"?>
<configuration scan="true" scanPeriod="30 seconds">

    <!-- ========== 1. 定义变量（日志存储路径 & 保留天数） ========== -->
    <property name="LOG_HOME" value="logs/student-system" />
    <property name="MAX_HISTORY" value="30" />

    <!-- ========== 2. 控制台输出（开发时方便调试） ========== -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <!-- ========== 3. 按天滚动的文件输出（生产环境主力） ========== -->
    <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <!-- 当前日志文件路径 -->
        <file>${LOG_HOME}/application.log</file>

        <!-- 滚动策略：按天滚动 -->
        <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
            <!-- 归档文件名格式：日期+序号，例如 application.2026-08-17.0.log -->
            <fileNamePattern>${LOG_HOME}/application.%d{yyyy-MM-dd}.%i.log</fileNamePattern>
            <!-- 保留最近 30 天的日志 -->
            <maxHistory>${MAX_HISTORY}</maxHistory>
            <!-- 单个日志文件最大 100MB，超过则自动分卷（序号递增） -->
            <timeBasedFileNamingAndTriggeringPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedFNATP">
                <maxFileSize>100MB</maxFileSize>
            </timeBasedFileNamingAndTriggeringPolicy>
        </rollingPolicy>

        <!-- 日志输出格式（与控制台一致，便于阅读） -->
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <!-- ========== 4. 针对不同环境的特殊配置 ========== -->
    <!-- 开发环境：只输出控制台，级别 DEBUG -->
    <springProfile name="dev">
        <root level="DEBUG">
            <appender-ref ref="CONSOLE" />
            <appender-ref ref="FILE" />   <!-- 加上这一行 -->
        </root>
    </springProfile>

    <!-- 生产环境：同时输出控制台（可选）和文件，级别 INFO -->
    <springProfile name="prod">
        <root level="INFO">
            <appender-ref ref="CONSOLE" />
            <appender-ref ref="FILE" />
        </root>
    </springProfile>

    <!-- 未指定 profile 时（兜底），默认输出控制台，级别 INFO -->
    <springProfile name="default">
        <root level="INFO">
            <appender-ref ref="CONSOLE" />
        </root>
    </springProfile>

</configuration>